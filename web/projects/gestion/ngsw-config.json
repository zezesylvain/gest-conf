{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/icon-*.png",
          "/*.css",
          "/*.js",
          "/media/**"
        ]
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*"]
}
