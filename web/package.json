{
  "name": "gestconf-web",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start:portail": "ng serve portail",
    "start:gestion": "ng serve gestion",
    "build": "ng build portail && node scripts/check-prerender.mjs dist/portail/browser && ng build gestion && node scripts/inject-csp.mjs dist/portail/browser dist/gestion/browser",
    "build:portail": "ng build portail && node scripts/check-prerender.mjs dist/portail/browser && node scripts/inject-csp.mjs dist/portail/browser",
    "test": "node --test 'scripts/*.test.mjs' && ng test shared --watch=false && ng test portail --watch=false && ng test gestion --watch=false",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "ng-openapi-gen -c ng-openapi-gen.json",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.1",
    "@ngx-translate/core": "^18.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.12.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "ng-openapi-gen": "^1.1.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  }
}
