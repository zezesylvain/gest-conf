# Copier en .env (jamais committé) et adapter. En production sur o2switch,
# placer ce fichier dans le dossier de l'application, hors de public_html.

# Le module de réglages n'est PAS choisi ici (ce fichier est lu par les réglages
# eux-mêmes) : manage.py utilise config.settings.dev par défaut, passenger_wsgi.py
# config.settings.prod ; sinon exporter DJANGO_SETTINGS_MODULE.

# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# MariaDB (utf8mb4). Sans cette variable, le développement bascule sur SQLite.
# Encoder les caractères spéciaux du mot de passe (ex. @ -> %40).
DATABASE_URL=mysql://gestconf:motdepasse@localhost:3306/gestconf

# Production uniquement
DJANGO_ALLOWED_HOSTS=conference.exemple.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://conference.exemple.org
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_SSL_REDIRECT=false

# URL publique du portail (production : https://…, obligatoire). Base des liens envoyés par
# e-mail (vérification d'adresse, réinitialisation du mot de passe), jamais déduite de
# l'en-tête Host. Développement : http://localhost:4200 par défaut.
# GESTCONF_PUBLIC_URL=https://conference.exemple.org

# Préfixe de montage de l'API (doit correspondre à « Application URL » dans cPanel)
GESTCONF_URL_PREFIX=/api

# Nombre de mandataires (proxys) de confiance devant Django, pour déterminer l'IP
# du client (limitation de débit, journal d'audit). 0 = défaut sûr : REMOTE_ADDR
# seul, l'en-tête X-Forwarded-For (forgeable) est ignoré. Valeur à mesurer sur
# o2switch avec l'endpoint de diagnostic ci-dessous (étape L1.0) avant de la changer.
GESTCONF_TRUSTED_PROXY_COUNT=0

# Endpoint de diagnostic GET /api/v1/diagnostics/request (REMOTE_ADDR, X-Forwarded-For,
# X-Real-IP, HTTPS, SCRIPT_NAME, PATH_INFO, IP calculée). Désactivé par défaut (404) ;
# ne l'activer que le temps d'une mesure, puis le désactiver.
# GESTCONF_DIAGNOSTICS=1

# --- 2FA (plan L1 §4.10) ------------------------------------------------------------------
# Clés Fernet chiffrant les secrets TOTP, séparées par des virgules (la première chiffre,
# toutes déchiffrent). Obligatoire en production. Générer une clé :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sauvegarder la clé HORS de l'hébergement, séparément des sauvegardes de la base : sa perte
# oblige chacun à réactiver sa 2FA. Rotation : voir deploy/README.md (rotate_mfa_keys).
# GESTCONF_MFA_ENCRYPTION_KEYS=

# --- E-mails (décision D10, plan L1 §8.3) ---------------------------------------------
# Développement : backend « console » par défaut (e-mails affichés dans le terminal).
# Production (obligatoire) : fournisseur par API via django-anymail, par exemple
#   anymail.backends.brevo.EmailBackend   (clé BREVO_API_KEY)
#   anymail.backends.mailjet.EmailBackend (clés MAILJET_API_KEY et MAILJET_SECRET_KEY)
# GESTCONF_EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
# Adresse d'expédition, d'un domaine dont SPF, DKIM et DMARC sont configurés chez le fournisseur.
DEFAULT_FROM_EMAIL=GEST-CONF <no-reply@conference.exemple.org>
# BREVO_API_KEY=
# MAILJET_API_KEY=
# MAILJET_SECRET_KEY=
# Plafond global d'envoi par heure (au-delà, les e-mails attendent en file).
# GESTCONF_EMAIL_MAX_PER_HOUR=200

# --- Opérateurs (décision D17) ---------------------------------------------------------
# Adresses recevant les alertes minimales (erreurs 5xx, tâches en échec, cron en erreur),
# séparées par des virgules. Vide : aucune alerte.
GESTCONF_OPERATORS=
# GESTCONF_OPERATOR_ALERTS_PER_HOUR=10

# --- Tâches planifiées (règle n° 9, plan L1 §8.4) --------------------------------------
# Intervalle réel du cron de run_jobs, en secondes (/health signale « late » après trois
# intervalles sans passage réussi). À aligner sur la crontab (décision H-6).
GESTCONF_CRON_INTERVAL_SECONDS=300
# Verrou des commandes cron (décision H-5) : flock (défaut) ou database (GET_LOCK MariaDB).
# GESTCONF_COMMAND_LOCK=flock
# Durées de conservation de D15 appliquées (sinon simulation seule). À n'activer qu'après
# validation des durées par le commanditaire.
# GESTCONF_RETENTION_ENFORCED=false

# --- Fichiers déposés (règle n° 8 ; lot L2, E4) -------------------------------------------
# Dossier HORS de la racine web (public_html), lisible par l'application seulement ; les
# fichiers publics sont dans le sous-dossier « public ». À inclure dans la sauvegarde.
# GESTCONF_FILES_DIR=/home/compte/gestconf-app/var/files
