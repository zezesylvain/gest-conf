# Copier en .env (jamais committé) et adapter. En production sur o2switch,
# placer ce fichier dans le dossier de l'application, hors de public_html.

# Le module de réglages n'est PAS choisi ici (ce fichier est lu par les réglages
# eux-mêmes) : manage.py utilise config.settings.dev par défaut, passenger_wsgi.py
# config.settings.prod ; sinon exporter DJANGO_SETTINGS_MODULE.

# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# MariaDB (utf8mb4). Sans cette variable, le développement bascule sur SQLite.
# Encoder les caractères spéciaux du mot de passe (ex. @ -> %40).
DATABASE_URL=mysql://gestconf:motdepasse@localhost:3306/gestconf

# Production uniquement
DJANGO_ALLOWED_HOSTS=conference.exemple.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://conference.exemple.org
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_SSL_REDIRECT=false

# Préfixe de montage de l'API (doit correspondre à « Application URL » dans cPanel)
GESTCONF_URL_PREFIX=/api

# Nombre de mandataires (proxys) de confiance devant Django, pour déterminer l'IP
# du client (limitation de débit, journal d'audit). 0 = défaut sûr : REMOTE_ADDR
# seul, l'en-tête X-Forwarded-For (forgeable) est ignoré. Valeur à mesurer sur
# o2switch avec l'endpoint de diagnostic ci-dessous (étape L1.0) avant de la changer.
GESTCONF_TRUSTED_PROXY_COUNT=0

# Endpoint de diagnostic GET /api/v1/diagnostics/request (REMOTE_ADDR, X-Forwarded-For,
# X-Real-IP, HTTPS, SCRIPT_NAME, PATH_INFO, IP calculée). Désactivé par défaut (404) ;
# ne l'activer que le temps d'une mesure, puis le désactiver.
# GESTCONF_DIAGNOSTICS=1

# --- E-mails (D10) -----------------------------------------------------------------------
# Production : fournisseur obligatoire pour que le site démarre (brevo, mailjet ou smtp,
# ce dernier en secours). Déclaré mais incomplet = aucun processus ne démarre. Les clés ne
# se mettent QUE dans le .env du serveur (droits 600), jamais dans le dépôt.
# Développement : e-mails affichés dans la console ; tests : en mémoire (aucune variable).
GESTCONF_EMAIL_PROVIDER=
# Expéditeur, sur le domaine authentifié SPF/DKIM/DMARC (obligatoire avec un fournisseur).
DEFAULT_FROM_EMAIL=GEST-CONF <no-reply@conference.exemple.org>
# Brevo
GESTCONF_BREVO_API_KEY=
# Mailjet
GESTCONF_MAILJET_API_KEY=
GESTCONF_MAILJET_SECRET_KEY=
# SMTP de secours (o2switch) : port 587 (STARTTLS) par défaut, 465 avec USE_SSL=true.
GESTCONF_SMTP_HOST=
# GESTCONF_SMTP_PORT=587
GESTCONF_SMTP_USER=
GESTCONF_SMTP_PASSWORD=
# GESTCONF_SMTP_USE_SSL=false
# Délai réseau d'un envoi par le cron, et de la voie rapide pendant une requête (secondes).
# GESTCONF_EMAIL_TIMEOUT=10
# GESTCONF_EMAIL_FAST_PATH_TIMEOUT=3
# Plafond global d'envoi par heure ; au-delà, les e-mails attendent en file.
# GESTCONF_EMAIL_MAX_PER_HOUR=300
# Nom du site dans les e-mails (fixe).
# GESTCONF_SITE_NAME=GEST-CONF

# --- Alertes aux opérateurs (D17) --------------------------------------------------------
# Erreur serveur ou tâche en échec définitif : e-mail minimal (type d'exception, chemin,
# identifiant de requête, heure ; jamais le corps, les en-têtes, les cookies ni les
# paramètres). Adresses séparées par des virgules ; vide = aucune alerte.
GESTCONF_OPERATOR_EMAILS=
# GESTCONF_OPERATOR_ALERTS_PER_HOUR=10

# --- Cron, file de tâches et conservation des données --------------------------------------
# Intervalle du cron de run_jobs en secondes (/health signale « late » après 3 intervalles
# sans passage réussi ; budget par défaut de run_jobs : 80 % de l'intervalle).
GESTCONF_CRON_INTERVAL_SECONDS=300
# Dossier des verrous des commandes cron (défaut : <application>/tmp).
# GESTCONF_LOCK_DIR=
# Purges du cadre légal (D15) : simulées tant que ce réglage vaut false (cadre légal Q14
# non tranché). Les purges de sécurité sont toujours actives.
GESTCONF_RETENTION_ENFORCE=false
