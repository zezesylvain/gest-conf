#: apps/core/management/commands/cleanup.py
msgid ""
"Purges quotidiennes : sécurité toujours ; durées de conservation (D15) en "
"simulation tant que GESTCONF_RETENTION_ENFORCE n'est pas activé."
msgstr ""
"Daily purges: security purges always; retention periods (D15) simulated until GESTCONF_RETENTION_ENFORCE is enabled."

#: apps/core/management/commands/cleanup.py
msgid "Simule aussi les purges du cadre légal, même si elles sont activées."
msgstr "Also simulates the legal retention purges, even when they are enabled."

