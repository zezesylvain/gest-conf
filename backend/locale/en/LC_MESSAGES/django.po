#: apps/communications/templates/communications/email/test_email_message.html
msgid "Bonjour,"
msgstr "Hello,"

#: apps/communications/templates/communications/email/test_email_message.html
#, python-format
msgid ""
"Ceci est un e-mail de test envoyé par l'équipe d'exploitation de "
"%(site_name)s, le %(timestamp)s."
msgstr ""
"This is a test email sent by the %(site_name)s operations team on %(timestamp)s."

#: apps/communications/templates/communications/email/test_email_message.html
msgid ""
"S'il vous parvient, la chaîne d'envoi fonctionne : file de tâches, cron et "
"fournisseur d'e-mails. Vous n'avez rien à faire."
msgstr ""
"If you receive it, the sending chain works: job queue, cron and email provider. There is nothing for you to do."

#: apps/communications/templates/communications/email/test_email_message.txt
#, python-format
msgid ""
"Bonjour,\n"
"\n"
"Ceci est un e-mail de test envoyé par l'équipe d'exploitation de "
"%(site_name)s, le %(timestamp)s.\n"
"\n"
"S'il vous parvient, la chaîne d'envoi fonctionne : file de tâches, cron et "
"fournisseur d'e-mails. Vous n'avez rien à faire."
msgstr ""
"Hello,\n"
"\n"
"This is a test email sent by the %(site_name)s operations team on %(timestamp)s.\n"
"\n"
"If you receive it, the sending chain works: job queue, cron and email provider. There is nothing for you to do."

#: apps/communications/templates/communications/email/test_email_subject.txt
#, python-format
msgid "[%(site_name)s] E-mail de test"
msgstr "[%(site_name)s] Test email"

