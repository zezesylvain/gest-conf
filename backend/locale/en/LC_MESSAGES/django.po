#: apps/accounts/templates/account/email/_security_footer.txt:1
#, python-format
msgid ""
"Si vous n'êtes pas à l'origine de cette opération, changez votre mot de "
"passe sans attendre et prévenez les organisateurs. Origine de la demande :\n"
"\n"
"- adresse IP : %(ip)s\n"
"- navigateur : %(user_agent)s\n"
"- date : %(timestamp)s"
msgstr ""
"If you did not make this change, change your password immediately and inform "
"the organizers. The request came from:\n"
"\n"
"- IP address: %(ip)s\n"
"- browser: %(user_agent)s\n"
"- date: %(timestamp)s"

#: apps/accounts/templates/account/email/_signature.txt:1
#, python-format
msgid ""
"Cordialement,\n"
"L'équipe %(site_name)s\n"
"\n"
"Ce message a été envoyé automatiquement ; merci de ne pas y répondre."
msgstr ""
"Best regards,\n"
"The %(site_name)s team\n"
"\n"
"This message was sent automatically; please do not reply."

#: apps/accounts/templates/account/email/account_already_exists_message.txt:1
#, python-format
msgid ""
"Bonjour,\n"
"\n"
"Une inscription à %(site_name)s a été demandée avec cette adresse, mais un "
"compte existe déjà. Vous pouvez vous connecter avec votre mot de passe ; si "
"vous l'avez oublié, réinitialisez-le ici :\n"
"\n"
"%(password_reset_url)s\n"
"\n"
"Si vous n'êtes pas à l'origine de cette demande, ignorez ce message : votre "
"compte n'a pas été modifié."
msgstr ""
"Hello,\n"
"\n"
"A %(site_name)s sign-up was requested with this address, but an account "
"already exists. You can sign in with your password; if you have forgotten "
"it, reset it here:\n"
"\n"
"%(password_reset_url)s\n"
"\n"
"If you did not make this request, ignore this message: your account has not "
"been changed."

#: apps/accounts/templates/account/email/account_already_exists_subject.txt:1
#, python-format
msgid "[%(site_name)s] Un compte existe déjà avec cette adresse"
msgstr "[%(site_name)s] An account already exists with this address"

#: apps/accounts/templates/account/email/email_added_message.txt:1
#, python-format
msgid ""
"Bonjour,\n"
"\n"
"L'adresse %(added_email)s vient d'être ajoutée à votre compte %(site_name)s. "
"Elle ne pourra servir qu'une fois confirmée par le lien qui lui a été envoyé."
msgstr ""
"Hello,\n"
"\n"
"The address %(added_email)s has just been added to your %(site_name)s "
"account. It can only be used once confirmed through the link sent to it."

#: apps/accounts/templates/account/email/email_added_subject.txt:1
#, python-format
msgid "[%(site_name)s] Une adresse e-mail a été ajoutée à votre compte"
msgstr "[%(site_name)s] An email address was added to your account"

#: apps/accounts/templates/account/email/email_changed_message.txt:1
#, python-format
msgid ""
"Bonjour,\n"
"\n"
"L'adresse principale de votre compte %(site_name)s est passée de "
"%(from_email)s à %(to_email)s."
msgstr ""
"Hello,\n"
"\n"
"The primary address of your %(site_name)s account has changed from "
"%(from_email)s to %(to_email)s."

#: apps/accounts/templates/account/email/email_changed_subject.txt:1
#, python-format
msgid "[%(site_name)s] Votre adresse e-mail principale a été modifiée"
msgstr "[%(site_name)s] Your primary email address was changed"

#: apps/accounts/templates/account/email/email_confirmation_message.txt:1
#, python-format
msgid ""
"Bonjour,\n"
"\n"
"Pour confirmer cette adresse sur votre compte %(site_name)s, ouvrez ce "
"lien :\n"
"\n"
"%(activate_url)s\n"
"\n"
"Si vous n'êtes pas à l'origine de cette demande, ignorez ce message."
msgstr ""
"Hello,\n"
"\n"
"To confirm this address on your %(site_name)s account, open this link:\n"
"\n"
"%(activate_url)s\n"
"\n"
"If you did not make this request, ignore this message."

#: apps/accounts/templates/account/email/email_confirmation_signup_message.txt:1
#, python-format
msgid ""
"Bonjour,\n"
"\n"
"Un compte %(site_name)s vient d'être créé avec cette adresse. Pour "
"l'activer, confirmez votre adresse en ouvrant ce lien :\n"
"\n"
"%(activate_url)s\n"
"\n"
"Si vous n'avez pas créé de compte, ignorez ce message : aucun compte ne sera "
"activé."
msgstr ""
"Hello,\n"
"\n"
"A %(site_name)s account has just been created with this address. To activate "
"it, confirm your address by opening this link:\n"
"\n"
"%(activate_url)s\n"
"\n"
"If you did not create an account, ignore this message: no account will be "
"activated."

#: apps/accounts/templates/account/email/email_confirmation_signup_subject.txt:1
#: apps/accounts/templates/account/email/email_confirmation_subject.txt:1
#, python-format
msgid "[%(site_name)s] Confirmez votre adresse e-mail"
msgstr "[%(site_name)s] Confirm your email address"

#: apps/accounts/templates/account/email/email_deleted_message.txt:1
#, python-format
msgid ""
"Bonjour,\n"
"\n"
"L'adresse %(deleted_email)s a été retirée de votre compte %(site_name)s."
msgstr ""
"Hello,\n"
"\n"
"The address %(deleted_email)s was removed from your %(site_name)s account."

#: apps/accounts/templates/account/email/email_deleted_subject.txt:1
#, python-format
msgid "[%(site_name)s] Une adresse e-mail a été retirée de votre compte"
msgstr "[%(site_name)s] An email address was removed from your account"

#: apps/accounts/templates/account/email/password_changed_message.txt:1
#, python-format
msgid ""
"Bonjour,\n"
"\n"
"Le mot de passe de votre compte %(site_name)s vient d'être modifié."
msgstr ""
"Hello,\n"
"\n"
"The password of your %(site_name)s account has just been changed."

#: apps/accounts/templates/account/email/password_changed_subject.txt:1
#, python-format
msgid "[%(site_name)s] Votre mot de passe a été modifié"
msgstr "[%(site_name)s] Your password was changed"

#: apps/accounts/templates/account/email/password_reset_key_message.txt:1
#, python-format
msgid ""
"Bonjour,\n"
"\n"
"Une réinitialisation du mot de passe de votre compte %(site_name)s a été "
"demandée. Pour choisir un nouveau mot de passe, ouvrez ce lien, valable deux "
"heures et utilisable une seule fois :\n"
"\n"
"%(password_reset_url)s\n"
"\n"
"Si vous n'êtes pas à l'origine de cette demande, ignorez ce message : votre "
"mot de passe reste inchangé."
msgstr ""
"Hello,\n"
"\n"
"A password reset was requested for your %(site_name)s account. To choose a "
"new password, open this link, valid for two hours and usable only once:\n"
"\n"
"%(password_reset_url)s\n"
"\n"
"If you did not make this request, ignore this message: your password remains "
"unchanged."

#: apps/accounts/templates/account/email/password_reset_key_subject.txt:1
#, python-format
msgid "[%(site_name)s] Réinitialisation de votre mot de passe"
msgstr "[%(site_name)s] Reset your password"

#: apps/accounts/templates/account/email/password_reset_message.txt:1
#, python-format
