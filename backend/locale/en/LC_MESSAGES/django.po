#: apps/submissions/templates/submission/email/coauthor_message.txt:1
#, python-format
msgid ""
"Bonjour,\n"
"\n"
"%(submitter_name)s vous a déclaré co-auteur de la soumission « %(title)s » (%(reference)s) à %(edition_title)s.\n"
"\n"
"Si ce n'est pas le cas, ou si votre adresse est erronée, prévenez %(submitter_name)s ou les organisateurs."
msgstr ""
"Hello,\n"
"\n"
"%(submitter_name)s has listed you as a co-author of the submission “%(title)s” (%(reference)s) to %(edition_title)s.\n"
"\n"
"If this is not the case, or if your address is wrong, please tell %(submitter_name)s or the organisers."

#: apps/submissions/templates/submission/email/coauthor_subject.txt:1
#, python-format
msgid "[%(site_name)s] Vous êtes déclaré co-auteur d'une soumission"
msgstr "[%(site_name)s] You have been listed as a co-author of a submission"

#: apps/submissions/templates/submission/email/draft_reminder_message.txt:1
#, python-format
msgid ""
"Bonjour,\n"
"\n"
"Votre brouillon « %(title)s » pour %(edition_title)s n'est pas encore soumis. L'appel à communications ferme le %(call_close)s : après cette date, il ne pourra plus l'être.\n"
"\n"
"Pour le terminer et le soumettre : %(link)s"
msgstr ""
"Hello,\n"
"\n"
"Your draft “%(title)s” for %(edition_title)s has not been submitted yet. The call for papers closes on %(call_close)s: after that date, it can no longer be submitted.\n"
"\n"
"To finish and submit it: %(link)s"

#: apps/submissions/templates/submission/email/draft_reminder_subject.txt:1
#, python-format
msgid "[%(site_name)s] Votre brouillon n'est pas encore soumis"
msgstr "[%(site_name)s] Your draft has not been submitted yet"

#: apps/submissions/templates/submission/email/extension_message.txt:1
#, python-format
msgid ""
"Bonjour,\n"
"\n"
"Un délai supplémentaire vous est accordé pour votre soumission « %(title)s » (%(reference)s) à %(edition_title)s, jusqu'au %(until)s.\n"
"\n"
"Motif : %(reason)s"
msgstr ""
"Hello,\n"
"\n"
"You have been granted an extended deadline for your submission “%(title)s” (%(reference)s) to %(edition_title)s, until %(until)s.\n"
"\n"
"Reason: %(reason)s"

#: apps/submissions/templates/submission/email/extension_subject.txt:1
#, python-format
