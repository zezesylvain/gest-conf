#: apps/communications/templates/communications/email/test_message.txt
#, python-format
msgid ""
"Bonjour,\n"
"\n"
"Ce message de test a été envoyé par la file d'envoi de %(site_name)s. Sa "
"réception confirme que la tâche planifiée (cron) et le fournisseur d'e-mails "
"fonctionnent.\n"
"\n"
"Aucune action n'est attendue de votre part."
msgstr ""
"Hello,\n"
"\n"
"This test message was sent by the %(site_name)s sending queue. Receiving it "
"confirms that the scheduled task (cron) and the email provider are working.\n"
"\n"
"No action is required on your part."

#: apps/communications/templates/communications/email/test_subject.txt
#, python-format
msgid "[%(site_name)s] E-mail de test"
msgstr "[%(site_name)s] Test email"

