msgstr "Runs pending jobs (to be launched by cron)."

#: apps/core/management/commands/run_jobs.py
#, python-format
msgid ""
"Budget de temps : aucune tâche n'est commencée au-delà (par défaut, 80 %% de "
"GESTCONF_CRON_INTERVAL_SECONDS). À garder inférieur à l'intervalle du cron."
msgstr ""
"Time budget: no job is started beyond it (default: 80 %% of GESTCONF_CRON_INTERVAL_SECONDS). Keep it below the cron interval."

#: apps/core/management/commands/run_jobs.py
msgid "--max-seconds doit être strictement positif."
msgstr "--max-seconds must be strictly positive."

#: apps/core/management/commands/run_jobs.py
#, python-format
msgid ""
"Tâches exécutées : %(processed)s ; reprises après bail expiré : "
"%(requeued)s ; passées en échec : %(failed)s."
msgstr ""
"Jobs run: %(processed)s; requeued after lease expiry: %(requeued)s; marked failed: %(failed)s."

