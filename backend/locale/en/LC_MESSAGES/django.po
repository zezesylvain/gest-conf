#: apps/reviews/templates/review/email/assigned_message.txt:1
#, python-format
msgid ""
"Bonjour,\n"
"\n"
"Le comité scientifique de %(edition_title)s vous confie l'évaluation de la "
"soumission %(reference)s « %(title)s ».\n"
"\n"
"Échéance : %(due)s\n"
"\n"
"Pour lire la soumission et saisir votre évaluation : %(link)s\n"
"\n"
"Si vous êtes en conflit d'intérêts avec cette soumission, ou si vous ne "
"pouvez pas l'évaluer, déclinez-la depuis le même lien."
msgstr ""
"Hello,\n"
"\n"
"The scientific committee of %(edition_title)s asks you to review submission "
"%(reference)s “%(title)s”.\n"
"\n"
"Due date: %(due)s\n"
"\n"
"To read the submission and enter your review: %(link)s\n"
"\n"
"If you have a conflict of interest with this submission, or cannot review "
"it, decline it from the same link."

#: apps/reviews/templates/review/email/assigned_subject.txt:1
#, python-format
msgid "[%(site_name)s] Nouvelle évaluation à réaliser"
msgstr "[%(site_name)s] New review to complete"

#: apps/reviews/templates/review/email/cancelled_message.txt:1
#, python-format
msgid ""
"Bonjour,\n"
"\n"
"Le comité scientifique de %(edition_title)s a annulé votre évaluation de la "
"soumission %(reference)s « %(title)s ». Vous n'avez plus à l'évaluer."
msgstr ""
"Hello,\n"
"\n"
"The scientific committee of %(edition_title)s has cancelled your review of "
"submission %(reference)s “%(title)s”. You no longer need to review it."

#: apps/reviews/templates/review/email/cancelled_subject.txt:1
#, python-format
msgid "[%(site_name)s] Évaluation annulée"
msgstr "[%(site_name)s] Review cancelled"

#: apps/reviews/templates/review/email/declined_message.txt:1
#, python-format
msgid ""
"Bonjour,\n"
"\n"
"Un relecteur a décliné l'évaluation de la soumission %(reference)s « "
"%(title)s » (%(edition_title)s). Désignez un remplaçant si le nombre de "
"relecteurs requis n'est plus atteint.\n"
"\n"
"Pilotage de l'évaluation : %(link)s"
msgstr ""
"Hello,\n"
"\n"
"A reviewer has declined to review submission %(reference)s "
"“%(title)s” (%(edition_title)s). Appoint a replacement if the required "
"number of reviewers is no longer met.\n"
"\n"
"Review follow-up: %(link)s"

#: apps/reviews/templates/review/email/declined_subject.txt:1
#, python-format
msgid "[%(site_name)s] Un relecteur a décliné une évaluation"
msgstr "[%(site_name)s] A reviewer declined a review"

#: apps/reviews/templates/review/email/divergence_message.txt:1
#, python-format
msgid ""
"Bonjour,\n"
"\n"
"Les évaluations de la soumission %(reference)s « %(title)s "
"» (%(edition_title)s) divergent : %(spread)s points d'écart sur 100, au-delà "
"du seuil de %(threshold)s points. Vous pouvez ouvrir la discussion ou "
"désigner un relecteur supplémentaire.\n"
"\n"
"Pilotage de l'évaluation : %(link)s"
msgstr ""
"Hello,\n"
"\n"
"The reviews of submission %(reference)s “%(title)s” (%(edition_title)s) "
"diverge: a %(spread)s-point gap out of 100, beyond the %(threshold)s-point "
"threshold. You can open the discussion or appoint an additional reviewer.\n"
"\n"
"Review follow-up: %(link)s"

#: apps/reviews/templates/review/email/divergence_subject.txt:1
#, python-format
msgid "[%(site_name)s] Évaluations divergentes"
msgstr "[%(site_name)s] Diverging reviews"

#: apps/reviews/templates/review/email/reminder_message.txt:3
#, python-format
msgid ""
"L'échéance de votre évaluation de la soumission %(reference)s « %(title)s "
"» (%(edition_title)s) est dépassée depuis le %(due)s. Merci de l'envoyer au "
"plus vite, ou de la décliner pour qu'un autre relecteur soit désigné."
msgstr ""
"Your review of submission %(reference)s “%(title)s” (%(edition_title)s) was "
"due on %(due)s. Please submit it as soon as possible, or decline it so that "
"another reviewer can be appointed."

#: apps/reviews/templates/review/email/reminder_message.txt:3
