# Dépendances d'exécution directes (communes à tous les environnements).
# Fichier source de pip-tools : le fichier verrouillé est base.txt (avec empreintes).
# Versions figées : toute montée de version passe par une PR dédiée, puis
# recompilation (voir « Dépendances Python » dans le README principal).
Django==5.2.17                # LTS (support jusqu'en avril 2028)
djangorestframework==3.18.1
drf-spectacular==0.30.0       # schéma OpenAPI -> client TypeScript Angular
django-filter==26.2
django-environ==0.14.0        # configuration par variables d'environnement
PyMySQL==1.2.3                # pilote MariaDB pur Python (pas de compilation sur o2switch)
django-anymail==15.2          # e-mails transactionnels par API (Brevo ou Mailjet, décision D10)
django-allauth[mfa]==65.19.7  # comptes, mode headless, 2FA TOTP (décisions D2, D4) ; tire qrcode (BSD)
cryptography==50.0.2          # chiffrement du secret TOTP (MultiFernet) ; version vérifiée par V03
fido2==2.2.1                  # importé par allauth.mfa même sans WebAuthn ; version vérifiée par V03
tzdata==2026.5                # fuseaux IANA pour zoneinfo (saisie des échéances, D13), pur Python
Pillow==12.3.0                # réencodage des images publiques (E4, plan L2) ; roue binaire vérifiée par V28
pypdf==6.19.0                 # contrôle et nettoyage des PDF déposés (F2, plan L3), pur Python
fpdf2==2.8.9                  # factures, avoirs et pro forma en PDF (J8, plan L6), pur Python ; LGPL-3.0
segno==1.6.6                  # QR des inscriptions (J11, plan L6), pur Python, sans dépendance ; BSD
